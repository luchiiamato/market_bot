# Runtime mode: local | host
MARKET_BOT_RUNTIME_MODE=local

# Local backend runtime
MARKET_BOT_LOCAL_BACKEND_HOST=127.0.0.1
MARKET_BOT_LOCAL_BACKEND_PORT=8000
MARKET_BOT_DB_PATH=./data/app/market_bot.db

# Host mode: frontend local or deployed, backend remoto
MARKET_BOT_HOSTED_API_BASE=https://market-bot-api.fly.dev

# Comma-separated exact origins for browsers
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://market-bot.vercel.app

# Optional regex for preview deployments or dynamic hosts
CORS_ALLOW_ORIGIN_REGEX=^https://market-bot(?:-[a-z0-9-]+)?\\.vercel\\.app$

# Optional external provider for richer news coverage
MARKETAUX_API_KEY=
